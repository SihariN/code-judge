{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "worker": "nodemon src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --selectProjects unit",
    "test:sandbox": "jest --selectProjects sandbox",
    "test:api": "jest --selectProjects api --runInBand --forceExit"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testTimeout": 60000,
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "sandbox",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/sandbox/**/*.test.js"
        ]
      },
      {
        "displayName": "api",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/api/**/*.test.js"
        ],
        "globalSetup": "<rootDir>/tests/api/global-setup.js",
        "setupFiles": [
          "<rootDir>/tests/api/setup-env.js"
        ]
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  }
}
