@baseUrl = http://localhost:5000/api

### 1. Register (expect 201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "Test@Example.com",
  "username": "testuser",
  "password": "supersecret123"
}

### 2. Bad input (expect 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "notanemail",
  "username": "a b!",
  "password": "123"
}

### 3. Login (expect 200 and a token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret123"
}

### 4. Wrong password (expect 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "wrongpassword"
}

### 5. Me without a token (expect 401)
GET {{baseUrl}}/auth/me

### 6. Me with a token (expect 200)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### 7. Me with a fake token (expect 401)
GET {{baseUrl}}/auth/me
Authorization: Bearer abc.def.ghi

### 8. Login as admin (get a fresh token)
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "supersecret123"
}

### 9. Register a normal student
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "username": "student1",
  "password": "supersecret123"
}

### 10. Login as student
# @name studentLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "supersecret123"
}

### 11. List problems (public, expect 4)
GET {{baseUrl}}/problems

### 12. Filter by difficulty
GET {{baseUrl}}/problems?difficulty=medium

### 13. One problem (expect only sample test cases)
GET {{baseUrl}}/problems/a-plus-b

### 14. Unknown problem (expect 404)
GET {{baseUrl}}/problems/does-not-exist

### 15. Create without token (expect 401)
POST {{baseUrl}}/problems
Content-Type: application/json

{}

### 16. Create as student (expect 403)
POST {{baseUrl}}/problems
Authorization: Bearer {{studentLogin.response.body.token}}
Content-Type: application/json

{}

### 17. Create as admin with bad data (expect 400)
POST {{baseUrl}}/problems
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "slug": "Bad Slug!",
  "title": "x",
  "description": "short",
  "difficulty": "IMPOSSIBLE",
  "testCases": []
}

### 18. Create as admin (expect 201)
POST {{baseUrl}}/problems
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "slug": "square-a-number",
  "title": "Square a Number",
  "description": "Read an integer and print its square.",
  "difficulty": "EASY",
  "timeLimitMs": 2000,
  "memoryLimitMb": 128,
  "testCases": [
    { "input": "4\n", "expectedOutput": "16", "isSample": true },
    { "input": "-3\n", "expectedOutput": "9" }
  ]
}

### 19. Create the same slug again (expect 409)
POST {{baseUrl}}/problems
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "slug": "square-a-number",
  "title": "Square a Number",
  "description": "Read an integer and print its square.",
  "difficulty": "EASY",
  "testCases": [
    { "input": "4\n", "expectedOutput": "16", "isSample": true }
  ]
}

### 20. Delete as admin (expect 204)
DELETE {{baseUrl}}/problems/square-a-number
Authorization: Bearer {{adminLogin.response.body.token}}

### 21. Delete again (expect 404)
DELETE {{baseUrl}}/problems/square-a-number
Authorization: Bearer {{adminLogin.response.body.token}}

### 22. Correct solution (expect ACCEPTED)
# @name ac
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "language": "python",
  "code": "a, b = map(int, input().split())\nprint(a + b)"
}

### 23. Wrong answer (expect WRONG_ANSWER, failure details shown)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "a, b = map(int, input().split())\nprint(a - b)"
}

### 24. Runtime error (expect RUNTIME_ERROR with a traceback)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "print(1 / 0)"
}

### 25. Syntax error (expect RUNTIME_ERROR mentioning SyntaxError)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "print('oops'"
}

### 26. Infinite loop (expect TIME_LIMIT_EXCEEDED after a few seconds)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "while True:\n    pass"
}

### 27. Memory bomb (expect MEMORY_LIMIT_EXCEEDED)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "x = 'a' * (10**9)\nprint(len(x))"
}

### 28. Cheater: hard-codes the sample answers (expect WRONG_ANSWER on test 4, no details)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "s = input().strip()\nprint(7 if s == '3 4' else 5 if s == '-5 10' else 0)"
}

### 29. FizzBuzz correct (expect ACCEPTED)
POST {{baseUrl}}/problems/fizzbuzz/submit
Authorization: Bearer {{studentLogin.response.body.token}}
Content-Type: application/json

{
  "code": "n = int(input())\nfor i in range(1, n + 1):\n    if i % 15 == 0:\n        print('FizzBuzz')\n    elif i % 3 == 0:\n        print('Fizz')\n    elif i % 5 == 0:\n        print('Buzz')\n    else:\n        print(i)"
}

### 30. No token (expect 401)
POST {{baseUrl}}/problems/a-plus-b/submit
Content-Type: application/json

{ "code": "print(1)" }

### 31. Unknown problem (expect 404)
POST {{baseUrl}}/problems/nope/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{ "code": "print(1)" }

### 32. Empty code (expect 400)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{ "code": "" }

### 33. My submissions (expect a list, newest first)
GET {{baseUrl}}/submissions
Authorization: Bearer {{adminLogin.response.body.token}}

### 34. My submissions for one problem
GET {{baseUrl}}/submissions?problem=a-plus-b&limit=3
Authorization: Bearer {{adminLogin.response.body.token}}

### 35. One submission with code (expect 200)
GET {{baseUrl}}/submissions/{{ac.response.body.submission.id}}
Authorization: Bearer {{adminLogin.response.body.token}}

### 36. Someone else's submission as student (expect 404)
GET {{baseUrl}}/submissions/{{ac.response.body.submission.id}}
Authorization: Bearer {{studentLogin.response.body.token}}

### 37. Submit a correct solution (expect 202 and verdict PENDING)
# @name q1
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "a, b = map(int, input().split())\nprint(a + b)"
}

### 38. Poll it (send this a few seconds after 37; expect ACCEPTED)
GET {{baseUrl}}/submissions/{{q1.response.body.submission.id}}
Authorization: Bearer {{adminLogin.response.body.token}}

### 39. Submit a wrong solution
# @name q2
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "a, b = map(int, input().split())\nprint(a - b)"
}

### 40. Poll it (expect WRONG_ANSWER with failure details)
GET {{baseUrl}}/submissions/{{q2.response.body.submission.id}}
Authorization: Bearer {{adminLogin.response.body.token}}

### 41. Submit an infinite loop (run this 4 times quickly)
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "while True:\n    pass"
}

### 42. See all my submissions and their statuses
GET {{baseUrl}}/submissions?limit=10
Authorization: Bearer {{adminLogin.response.body.token}}

### 43. Submit while the worker is stopped
# @name q4
POST {{baseUrl}}/problems/a-plus-b/submit
Authorization: Bearer {{adminLogin.response.body.token}}
Content-Type: application/json

{
  "code": "a, b = map(int, input().split())\nprint(a + b)"
}

### 44. Poll the one from request 43
GET {{baseUrl}}/submissions/{{q4.response.body.submission.id}}
Authorization: Bearer {{adminLogin.response.body.token}}